---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro'
import createSlug from '../../lib/createSlug.ts'

const posts = await getCollection('blog');
posts.sort((a, b) => Date.parse(b.data.date.toDateString()) - Date.parse(a.data.date.toDateString()))
---
<BlogLayout>
  <h1 class="sr-only">Blog Posts</h1>
  <ul>
    { posts.map((post) => (
    <li>
      <a href=`/blog/${createSlug(post.data.title)}`>
        <section>
          <h2>{post.data.title}</h2>
          <time>{
            new Date(post.data.date)
              .toLocaleString('pt-BR', {
                day: '2-digit',
                month: 'long',
                year: 'numeric',
                timeZone: 'UTC'
              })
            }
          </time>

          {post.data.description && <h3>{post.data.description}</h3> }
        </section>
      </a>
    </li>
    ))}
  </ul>
</BlogLayout>

<style>
  li {
    border-bottom: 1px dotted;
  }

  section {
    padding: 15px 0 15px 0;
  }

  h2 {
    font-weight: 700;
    padding-top: 10px;
    font-size: 28px;
  }

  time {
    display: block;
    padding-top: 5px;
    font-size: 12px;
  }

  h3 {
    font-size: 15px;
    padding-top: 15px;
  }
</style>
